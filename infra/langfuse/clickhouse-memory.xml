<clickhouse>
  <!-- ClickHouse reads the container's memory limit (2.5 GiB) and keeps itself below this share of it -->
  <max_server_memory_usage_to_ram_ratio>0.8</max_server_memory_usage_to_ram_ratio>

  <!-- Small caches: this host serves one project, not a fleet -->
  <mark_cache_size>268435456</mark_cache_size>
  <uncompressed_cache_size>0</uncompressed_cache_size>
  <background_pool_size>8</background_pool_size>

  <!-- ClickHouse writes a lot about itself to its own tables and logs them to disk by default.
       On a small host that is mostly memory and disk spent on its own diary. -->
  <query_log remove="1"/>
  <query_thread_log remove="1"/>
  <query_views_log remove="1"/>
  <part_log remove="1"/>
  <text_log remove="1"/>
  <trace_log remove="1"/>
  <metric_log remove="1"/>
  <asynchronous_metric_log remove="1"/>
  <opentelemetry_span_log remove="1"/>
  <processors_profile_log remove="1"/>
</clickhouse>
